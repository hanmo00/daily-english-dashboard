    {"id": "RP-002", "category": "project", "level": "B2", "scenario": "Explain a quality issue found before release.", "learnerRole": "product owner", "partnerRole": "executive", "structure": ["issue", "evidence", "options", "recommendation"], "targetExpressions": ["We identified...", "The trade-off is...", "My recommendation is..."], "surprise": "Why was this not caught earlier?", "success": "Take ownership without overpromising."},
    {"id": "RP-003", "category": "meeting", "level": "B2", "scenario": "Lead a weekly status meeting with an overloaded agenda.", "learnerRole": "chair", "partnerRole": "team members", "structure": ["goal", "priority", "discussion", "actions"], "targetExpressions": ["Let's focus on...", "Before we move on...", "To recap..."], "surprise": "A stakeholder raises an unrelated urgent issue.", "success": "Protect the agenda and acknowledge urgency."},
    {"id": "RP-004", "category": "decision", "level": "B2", "scenario": "Request approval for a revised launch date.", "learnerRole": "program manager", "partnerRole": "director", "structure": ["context", "options", "recommendation", "decision"], "targetExpressions": ["We have two viable options.", "On balance...", "Could you confirm..."], "surprise": "The director asks for a third option.", "success": "State boundaries and next steps."},
    {"id": "RP-005", "category": "comparison", "level": "B2", "scenario": "Compare two software vendors.", "learnerRole": "buyer", "partnerRole": "finance lead", "structure": ["criteria", "option A", "option B", "recommendation"], "targetExpressions": ["In terms of...", "Whereas...", "The deciding factor is..."], "surprise": "The cheaper vendor offers a last-minute discount.", "success": "Reassess using consistent criteria."},
    {"id": "RP-006", "category": "negotiation", "level": "B2+", "scenario": "Negotiate delivery dates with an overseas supplier.", "learnerRole": "operations manager", "partnerRole": "supplier", "structure": ["interests", "constraint", "offer", "confirmation"], "targetExpressions": ["If you can..., we can...", "Our main constraint is...", "Would that work for you?"], "surprise": "Shipping costs increase.", "success": "Make a conditional offer."},
